+        install_ps1 = REPO_ROOT / "install.ps1"
+        if not install_ps1.exists():
+            pytest.skip("install.ps1 not present")
+        content = install_ps1.read_text()
+        assert "[full]" in content, "install.ps1 must reference [full] extra"
