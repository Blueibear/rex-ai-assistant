+            dep.split(">=")[0].split(">")[0].split("<")[0].split("==")[0].strip().lower()
+            for dep in optional_deps["full"]
+        ]
+
+    def test_twilio_in_full(self, optional_deps: dict) -> None:
+        pkgs = self._packages(optional_deps)
+        assert "twilio" in pkgs
